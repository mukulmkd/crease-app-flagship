# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API) — use the Crease project, not other orgs
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose as NEXT_PUBLIC_*
# Required for seed:dev and the local fixed-OTP bypass.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push (VAPID) — `npx web-push generate-vapid-keys`
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Apple rejects BadJwtToken unless subject is a real mailto: or https: URL
# (fake TLDs like @team.crease fail on iOS; Android/FCM is more lenient).
# VAPID_SUBJECT=mailto:you@example.com

# Enable service worker during `next dev` for mobile push QA (optional)
# ENABLE_PWA_DEV=true

# Shared secret between Supabase Cron / Edge Functions and /api/internal/push.
# Without it the route returns 503 and scheduled jobs deliver no OS push.
# Generate: openssl rand -hex 32
# CRON_SECRET=
# Edge Functions additionally need APP_URL (public app origin, no trailing slash)
# set via `supabase secrets set` — they cannot reach localhost.

# Fixed OTP for seeded phones (local + Vercel demo). Remove both to disable.
# AUTH_DEV_FIXED_OTP=123456
# NEXT_PUBLIC_AUTH_DEV_OTP=123456

# Logging: debug | info | warn | error (default: debug in dev, info in prod)
# LOG_LEVEL=debug

# After env is set:
#   npx supabase link --project-ref <ref> && npx supabase db push --linked
#   npm run seed:dev
# Login: 9999900001 … 9999900004 with OTP 123456
